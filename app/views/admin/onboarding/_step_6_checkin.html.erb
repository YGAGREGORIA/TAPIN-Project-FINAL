<h1 class="onboarding-title">Studio Check-in setup</h1>
<p class="onboarding-desc">
  Create a QR code that customers can scan at the studio to automatically check in and earn points.
</p>

<% checkin_url = @studio ? "#{request.base_url}/s/#{@studio.slug}" : "#" %>
<% qr_api_url = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=#{CGI.escape(checkin_url)}" %>

<div class="onboarding-checkin-grid mb-4">
  <%# Left column — how it works %>
  <div>
    <h3 class="onboarding-card-heading mb-3">How it works:</h3>
    <div class="onboarding-how-steps">
      <div class="onboarding-how-step">
        <div class="onboarding-how-badge">1</div>
        <span>Customers scan the QR code when entering the studio</span>
      </div>
      <div class="onboarding-how-step">
        <div class="onboarding-how-badge">2</div>
        <span>The visit is automatically recorded</span>
      </div>
      <div class="onboarding-how-step">
        <div class="onboarding-how-badge">3</div>
        <span>Rewards and loyalty points are updated</span>
      </div>
    </div>

    <div class="onboarding-next-steps">
      <h4 class="onboarding-card-heading mb-3">Next steps:</h4>
      <div class="onboarding-next-step">
        <i class="fa fa-download"></i>
        <%= link_to "Download the QR Code", qr_api_url, download: "studio-checkin-qr.png", class: "onboarding-next-link" %>
      </div>
      <div class="onboarding-next-step">
        <i class="fa fa-print"></i>
        <span>Print it</span>
      </div>
      <div class="onboarding-next-step">
        <i class="fa fa-door-open"></i>
        <span>Place it at your studio entrance</span>
      </div>
    </div>
  </div>

  <%# Right column — dynamic QR code %>
  <div class="onboarding-qr-container">
    <div class="onboarding-qr-card">
      <% if @studio %>
        <img src="<%= qr_api_url %>" alt="Studio Check-in QR Code" width="220" height="220" class="onboarding-qr-image" />
      <% else %>
        <div class="onboarding-qr-placeholder">
          <i class="fa fa-qrcode"></i>
        </div>
      <% end %>
      <p class="onboarding-qr-label"><%= @studio&.name || "Studio" %> Check-in</p>
      <p class="onboarding-qr-url"><%= checkin_url %></p>
    </div>
  </div>
</div>

<div class="onboarding-actions">
  <%= render "admin/onboarding/back_button" %>
  <%= button_to "Continue", advance_admin_onboarding_path,
        method: :post,
        class: "btn onboarding-btn-primary",
        data: { turbo: false } %>
</div>
