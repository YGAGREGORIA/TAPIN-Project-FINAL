<%= form_with url: request.path, method: :get, class: "d-flex gap-2 align-items-end flex-wrap", data: { turbo_frame: "_top" } do |f| %>
  <div>
    <div class="text-muted small mb-1">From</div>
      <%= f.date_field :start_date, value: @start_date.to_date, class: "form-control form-control-sm", style: "max-width: 160px;" %>
  </div>
  <div>
    <div class="text-muted small mb-1">To</div>
    <%= f.date_field :end_date, value: @end_date.to_date, class: "form-control form-control-sm", style: "max-width: 160px;" %>
  </div>
  <div>
    <%= f.submit "Apply", class: "btn btn-dark btn-sm" %>
  </div>
<% end %>
