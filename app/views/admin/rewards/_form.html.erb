<%= form_with model: [:admin, reward], class: "admin-card" do |f| %>
  <div class="admin-card-header">
    <span><%= reward.persisted? ? "Edit Reward" : "New Reward" %></span>
    <%= link_to "Back", admin_rewards_path(tab: "rewards"), class: "admin-card-link" %>
  </div>

  <div class="p-3">
    <% if reward.errors.any? %>
      <div class="alert alert-danger">
        <%= reward.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.label :name, "Title", class: "form-label" %>
        <%= f.text_field :name, class: "form-control", placeholder: "Free Class After 10 Visits" %>
      </div>

      <div class="col-md-6">
        <%= f.label :reward_type, "Type", class: "form-label" %>
        <%= f.select :reward_type, Reward.reward_types.keys.map { |key| [key.humanize, key] }, {}, class: "form-select" %>
      </div>

      <div class="col-md-6">
        <%= f.label :points_cost, "Points Cost", class: "form-label" %>
        <%= f.number_field :points_cost, class: "form-control", min: 0, placeholder: "0" %>
      </div>

      <div class="col-md-6">
        <%= f.label :image_url, "Image URL", class: "form-label" %>
        <%= f.text_field :image_url, class: "form-control", placeholder: "https://example.com/reward.png" %>
      </div>

      <div class="col-12">
        <%= f.label :description, class: "form-label" %>
        <%= f.text_area :description, class: "form-control", rows: 4, placeholder: "Describe what members unlock." %>
      </div>

      <div class="col-12">
        <div class="form-check mt-2">
          <%= f.check_box :active, class: "form-check-input" %>
          <%= f.label :active, "Active", class: "form-check-label" %>
        </div>
      </div>
    </div>
  </div>

  <div class="p-3 border-top d-flex gap-2 justify-content-end">
    <%= link_to "Cancel", admin_rewards_path(tab: "rewards"), class: "btn btn-outline-secondary" %>
    <%= f.submit reward.persisted? ? "Save Changes" : "Create Reward", class: "btn btn-dark" %>
  </div>
<% end %>
