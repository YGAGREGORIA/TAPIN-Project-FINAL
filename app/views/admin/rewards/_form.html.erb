<%= form_with(model: [:admin, @reward], local: true, data: { turbo: false }) do |f| %>
  <%= render "devise/shared/error_messages", resource: @reward if @reward.errors.any? %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", placeholder: "e.g. Free Class" %>
  </div>

  <div class="mb-3">
    <%= f.label :visits_required, "Visits Required", class: "form-label" %>
    <%= f.number_field :visits_required, class: "form-control", min: 1, placeholder: "10", value: @reward.visits_required || 10 %>
    <div class="form-text">How many visits before a member unlocks this reward?</div>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 3, placeholder: "Describe this reward..." %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :reward_type, class: "form-label" %>
      <%= f.select :reward_type, Reward.reward_types.keys.map { |k| [k.humanize, k] }, {}, class: "form-select" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :points_cost, class: "form-label" %>
      <%= f.number_field :points_cost, class: "form-control", min: 0, placeholder: "e.g. 100" %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :image_url, "Image URL", class: "form-label" %>
    <%= f.url_field :image_url, class: "form-control", placeholder: "https://..." %>
  </div>

  <div class="mb-4 form-check">
    <%= f.check_box :active, class: "form-check-input" %>
    <%= f.label :active, "Active", class: "form-check-label" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_rewards_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
