<% content_for :title, "Delete Reward" %>

<div class="admin-card">
  <div class="admin-card-header">
    <span>Delete Reward</span>
    <%= link_to "Back", admin_rewards_path(tab: "rewards"), class: "admin-card-link" %>
  </div>

  <div class="p-4">
    <h1 class="admin-page-title mb-2"><%= @reward.name %></h1>
    <p class="text-muted mb-4">This will permanently remove the reward and its redemption history. This action cannot be undone.</p>

    <div class="d-flex gap-2 justify-content-end flex-wrap">
      <%= link_to "Cancel", admin_rewards_path(tab: "rewards"), class: "btn btn-outline-secondary" %>
      <%= button_to "Delete Reward", admin_reward_path(@reward), method: :delete, class: "btn btn-outline-danger" %>
    </div>
  </div>
</div>
