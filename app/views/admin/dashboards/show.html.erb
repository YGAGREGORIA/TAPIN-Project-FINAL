<% content_for :title, "Dashboard" %>

<div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
  <div>
    <h1 class="admin-page-title mb-1">Dashboard</h1>
    <p class="text-muted mb-0">Welcome back. Here is the latest view of your studio activity.</p>
  </div>
  <% if @studio %>
    <div class="d-flex gap-2">
      <%= link_to "Analytics", admin_analytics_path, class: "btn btn-sm btn-admin-outline" %>
      <%= link_to "Members", admin_members_path, class: "btn btn-sm btn-admin-outline" %>
    </div>
  <% end %>
</div>

<div class="admin-section-title mb-3">
  <span>Overview</span>
  <span class="admin-section-subtitle">The most important performance numbers for your studio.</span>
</div>

<div class="admin-card mb-4">
  <div class="row g-3 p-3">
    <div class="col-6 col-md-3">
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><i class="fa fa-users"></i></div>
        <div class="admin-stat-value"><%= @total_members %></div>
        <div class="admin-stat-label">Total Members</div>
        <div class="admin-stat-delta">
          <%= @new_members_this_week.positive? ? "+#{@new_members_this_week} this week" : "No new members this week" %>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><i class="fa fa-check-circle"></i></div>
        <div class="admin-stat-value"><%= @total_visits %></div>
        <div class="admin-stat-label">Total Check-ins</div>
        <div class="admin-stat-delta">
          <%= @visits_this_week.positive? ? "+#{@visits_this_week} this week" : "No check-ins this week" %>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><i class="fa fa-tag"></i></div>
        <div class="admin-stat-value"><%= @active_deals %></div>
        <div class="admin-stat-label">Active Deals</div>
        <div class="admin-stat-delta"><%= @total_deal_claims %> claimed</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="admin-stat-card">
        <div class="admin-stat-icon"><i class="fa fa-gift"></i></div>
        <div class="admin-stat-value"><%= @active_rewards %></div>
        <div class="admin-stat-label">Active Rewards</div>
        <div class="admin-stat-delta"><%= @total_redemptions %> redeemed</div>
      </div>
    </div>
  </div>
</div>

<div class="admin-section-title mb-3">
  <span>Loyalty</span>
  <span class="admin-section-subtitle">Active rewards and deals, using only the data already available in your studio.</span>
</div>

<div class="admin-card mb-4">
  <div class="admin-card-header">
    <span>Rewards & Deals</span>
    <div class="d-flex gap-3">
      <%= link_to "Rewards", admin_rewards_path, class: "admin-card-link" %>
      <%= link_to "Deals", admin_deals_path, class: "admin-card-link" %>
    </div>
  </div>

  <div class="row g-3 p-3">
    <div class="col-lg-6">
      <div class="h-100 border rounded-3 p-3">
        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
          <div>
            <div class="fw-semibold">Active Rewards</div>
            <div class="text-muted small"><%= @active_rewards %> active rewards currently available</div>
          </div>
        </div>

        <% if @featured_rewards.any? %>
          <% @featured_rewards.each do |reward| %>
            <div class="admin-activity-row px-0">
              <div class="admin-activity-avatar">
                <i class="fa fa-gift"></i>
              </div>
              <div class="admin-activity-details">
                <div class="admin-activity-name"><%= reward.name %></div>
                <div class="admin-activity-meta">
                  <%= reward.description.presence || reward.reward_type.humanize %>
                  <% reward_redemption_count = reward.reward_redemptions.count %>
                  &middot; used <%= reward_redemption_count %> times
                  <% if reward.points_cost.present? %>
                    &middot; <%= reward.points_cost %> pts
                  <% end %>
                </div>
              </div>
              <%= link_to "Edit", edit_admin_reward_path(reward), class: "admin-activity-link" %>
            </div>
          <% end %>
        <% else %>
          <div class="admin-empty-state px-0">No active rewards yet.</div>
        <% end %>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="h-100 border rounded-3 p-3">
        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
          <div>
            <div class="fw-semibold">Active Deals</div>
            <div class="text-muted small"><%= @active_deals %> active deals currently available</div>
          </div>
        </div>

        <% if @featured_deals.any? %>
          <% @featured_deals.each do |deal| %>
            <div class="admin-activity-row px-0">
              <div class="admin-activity-avatar">
                <i class="fa fa-tag"></i>
              </div>
              <div class="admin-activity-details">
                <div class="admin-activity-name"><%= deal.name %></div>
                <div class="admin-activity-meta">
                  <%= deal.deal_type.humanize %>
                  <% if deal.trigger_condition.present? %>
                    &middot; <%= deal.trigger_condition.humanize %>
                  <% end %>
                  <% deal_claim_count = deal.deal_claims.count %>
                  &middot; used <%= deal_claim_count %> times
                  <% if deal.discount_percent.present? && deal.discount_percent.positive? %>
                    &middot; <%= deal.discount_percent %>% off
                  <% end %>
                </div>
              </div>
              <%= link_to "Edit", edit_admin_deal_path(deal), class: "admin-activity-link" %>
            </div>
          <% end %>
        <% else %>
          <div class="admin-empty-state px-0">No active deals yet.</div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="admin-section-title mb-3">
  <span>Recent Visits</span>
  <span class="admin-section-subtitle">A quieter, list-based view of the latest member visits and signups.</span>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-6">
    <div class="admin-card h-100">
      <div class="admin-card-header">
        <span>Recent Check-ins</span>
        <%= link_to "View Analytics", admin_analytics_path, class: "admin-card-link" %>
      </div>
      <% if @recent_visits.any? %>
        <% @recent_visits.each do |visit| %>
          <div class="admin-activity-row">
            <div class="admin-activity-avatar">
              <%= visit.user.first_name.to_s.first&.upcase || visit.user.email.to_s.first&.upcase || "?" %>
            </div>
            <div class="admin-activity-details">
              <div class="admin-activity-name"><%= [visit.user.first_name, visit.user.last_name].compact.join(" ").presence || visit.user.email %></div>
              <div class="admin-activity-meta">
                <%= visit.class_config&.class_name || "Class visit" %>
                &middot;
                <%= visit.visited_at.strftime("%b %-d, %H:%M") %>
              </div>
            </div>
            <% if visit.points_earned.to_i.positive? %>
              <div class="admin-activity-points">+<%= visit.points_earned %> pts</div>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="admin-empty-state">No check-ins yet.</div>
      <% end %>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="admin-card h-100">
      <div class="admin-card-header">
        <span>New Members</span>
        <%= link_to "View All", admin_members_path, class: "admin-card-link" %>
      </div>
      <% if @recent_members.any? %>
        <% @recent_members.each do |member| %>
          <div class="admin-activity-row">
            <div class="admin-activity-avatar">
              <%= member.first_name.to_s.first&.upcase || member.email.to_s.first&.upcase || "?" %>
            </div>
            <div class="admin-activity-details">
              <div class="admin-activity-name"><%= [member.first_name, member.last_name].compact.join(" ").presence || member.email %></div>
              <div class="admin-activity-meta">
                <%= member.email %>
                &middot;
                joined <%= member.created_at.strftime("%b %-d") %>
              </div>
            </div>
            <%= link_to "View", admin_member_path(member), class: "admin-activity-link" %>
          </div>
        <% end %>
      <% else %>
        <div class="admin-empty-state">No members yet.</div>
      <% end %>
    </div>
  </div>
</div>
