<% content_for :title, @klass.class_description&.name || "Class Details" %>

<div class="mb-4">
  <%= link_to "← Back to Classes", admin_classes_path, class: "text-decoration-none" %>
</div>

<div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-4">
  <div>
    <h1 class="admin-page-title mb-1"><%= @klass.class_description&.name || "Class" %></h1>
    <p class="text-muted mb-0">
      <%= @klass.start_datetime.strftime("%A, %B %-d, %Y at %-I:%M %p") %>
      –
      <%= @klass.end_datetime.strftime("%-I:%M %p") %>
    </p>
  </div>
  <% if @klass.is_canceled %>
    <span class="badge bg-danger px-3 py-2">Canceled</span>
  <% elsif @klass.start_datetime > Time.current %>
    <span class="badge bg-success px-3 py-2">Upcoming</span>
  <% else %>
    <span class="badge bg-secondary px-3 py-2">Completed</span>
  <% end %>
</div>

<%# ── Class Info ── %>
<div class="admin-card mb-4">
  <div class="admin-card-header"><span>Class Details</span></div>
  <div class="p-3">
    <div class="row g-3">
      <div class="col-md-6">
        <div class="text-muted small mb-1">Class Type</div>
        <div class="fw-semibold"><%= @klass.class_description&.name %></div>
      </div>
      <div class="col-md-6">
        <div class="text-muted small mb-1">Teacher</div>
        <div class="fw-semibold"><%= @klass.staff&.first_name %> <%= @klass.staff&.last_name %></div>
      </div>
      <div class="col-md-6">
        <div class="text-muted small mb-1">Duration</div>
        <div class="fw-semibold"><%= @klass.class_description&.duration_minutes || "—" %> minutes</div>
      </div>
      <div class="col-md-6">
        <div class="text-muted small mb-1">Category</div>
        <div class="fw-semibold"><%= @klass.class_description&.category.presence || "—" %></div>
      </div>
      <div class="col-md-6">
        <div class="text-muted small mb-1">Capacity</div>
        <div class="fw-semibold"><%= @klass.total_booked || 0 %> / <%= @klass.max_capacity || "∞" %></div>
      </div>
      <% if @klass.location.present? %>
        <div class="col-md-6">
          <div class="text-muted small mb-1">Location</div>
          <div class="fw-semibold"><%= @klass.location %></div>
        </div>
      <% end %>
    </div>

    <% if @klass.class_description&.description.present? %>
      <div class="mt-3 pt-3 border-top">
        <div class="text-muted small mb-1">Description</div>
        <p class="mb-0"><%= @klass.class_description.description %></p>
      </div>
    <% end %>
  </div>
</div>

<%# ── Attendees ── %>
<div class="admin-card">
  <div class="admin-card-header">
    <span>Attendees</span>
    <span class="text-muted fw-normal"><%= @klass.client_visits.size %> check-ins</span>
  </div>

  <% if @klass.client_visits.any? %>
    <% @klass.client_visits.each do |cv| %>
      <div class="admin-activity-row">
        <div class="admin-activity-avatar"><i class="fa fa-user"></i></div>
        <div class="admin-activity-details">
          <div class="admin-activity-name">Client #<%= cv.mb_client_id %></div>
          <div class="admin-activity-meta">
            <span>Visited <%= cv.created_at.strftime("%b %-d, %Y at %-I:%M %p") %></span>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="admin-empty-state">No attendees recorded for this class.</div>
  <% end %>
</div>
