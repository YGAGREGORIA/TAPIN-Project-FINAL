<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "TapIn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="TapIn">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Inject approved studio brand theme — overrides CSS custom properties and fonts.
        Applied whenever @studio has an AI-approved brand (primary_color present).
        Falls back to vibe keywords if brand colours haven't been approved yet. %>
    <% brand = @studio&.studio_brand %>
    <% if brand&.primary_color.present? %>
      <%# Load studio's custom fonts from Google Fonts %>
      <% if brand.font_heading.present? || brand.font_body.present? %>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=<%= brand.font_heading&.gsub(' ', '+') %>:wght@600;700&family=<%= brand.font_body&.gsub(' ', '+') %>:wght@400;500&display=swap" rel="stylesheet">
      <% end %>
      <style>
        :root {
          --primary:            <%= brand.primary_color %>;
          --primary-foreground: #ffffff;
          --accent:             <%= brand.secondary_color || brand.primary_color %>;
          --accent-foreground:  #ffffff;
          --background:         <%= brand.background_color || '#FDFDF8' %>;
          --foreground:         <%= brand.text_color || '#1A1A1A' %>;
          <% if brand.font_heading.present? %>
          --font-heading: '<%= brand.font_heading %>', sans-serif;
          <% end %>
          <% if brand.font_body.present? %>
          --font-body: '<%= brand.font_body %>', sans-serif;
          <% end %>
        }
        <% if brand.font_heading.present? %>
        h1, h2, h3, h4, h5, h6, .dashboard-hero, .landing-headline { font-family: '<%= brand.font_heading %>', sans-serif; }
        <% end %>
        <% if brand.font_body.present? %>
        body { font-family: '<%= brand.font_body %>', sans-serif; }
        <% end %>
      </style>
    <% elsif brand&.vibe_keywords&.any? %>
      <style><%= studio_vibe_styles(brand).html_safe %></style>
    <% end %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/navbar" %>

    <% if notice.present? %>
      <div class="alert alert-success alert-dismissible fade show m-0 rounded-0" role="alert">
        <div class="container"><%= notice %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0" role="alert">
        <div class="container"><%= alert %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <%= yield %>

    <% if user_signed_in? && !request.path.start_with?('/admin') %>
      <% unless controller_name == 'chats' %>
        <%= link_to chats_path, class: "ai-bubble", "aria-label": "AI Assistant" do %>
          <i class="bi bi-stars"></i>
          <span class="badge rounded-pill bg-success position-absolute top-0 end-0">2</span>
        <% end %>
      <% end %>
      <%= render 'shared/bottom_nav' %>
    <% end %>
  </body>
</html>
