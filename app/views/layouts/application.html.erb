<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "TapIn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="TapIn">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% unless user_signed_in? %>
      <meta name="turbo-cache-control" content="no-cache">
    <% end %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <% if user_signed_in? && @studio_brand&.primary_color.present? %>
      <% fonts = [@studio_brand.font_heading, @studio_brand.font_body].compact.uniq %>
      <% if fonts.any? %>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?<%= fonts.map { |f| "family=#{URI.encode_www_form_component(f)}:wght@400;600;700" }.join('&') %>&display=swap" rel="stylesheet">
      <% end %>
      <style>
        :root {
          --primary:            <%= @studio_brand.primary_color %>;
          --primary-foreground: #ffffff;
          --accent:             <%= @studio_brand.secondary_color %>;
          --accent-foreground:  #ffffff;
          --background:         <%= @studio_brand.background_color || '#ffffff' %>;
          --foreground:         <%= @studio_brand.text_color %>;
          --card:               <%= @studio_brand.background_color || '#ffffff' %>;
          --card-foreground:    <%= @studio_brand.text_color %>;
          --border:             <%= @studio_brand.primary_color %>26;
          <% if @studio_brand.font_heading.present? %>
          --font-heading: '<%= @studio_brand.font_heading %>', sans-serif;
          <% end %>
          <% if @studio_brand.font_body.present? %>
          --font-body: '<%= @studio_brand.font_body %>', sans-serif;
          font-family: '<%= @studio_brand.font_body %>', sans-serif;
          <% end %>
        }
      </style>
    <% end %>

    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/navbar" %>

    <% if notice.present? %>
      <div class="alert alert-success alert-dismissible fade show m-0 rounded-0" role="alert">
        <div class="container"><%= notice %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0" role="alert">
        <div class="container"><%= alert %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% end %>

    <%= yield %>

    <% if user_signed_in? && !request.path.start_with?('/admin') %>
      <% unless controller_name == 'chats' %>
        <%= link_to chats_path, class: "ai-bubble", "aria-label": "AI Assistant" do %>
          <i class="bi bi-stars"></i>
        <% end %>
      <% end %>
      <%= render 'shared/bottom_nav' %>
    <% end %>
  </body>
</html>
