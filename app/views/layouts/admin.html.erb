<!DOCTYPE html>
<html>
  <head>
    <title>TapIn Admin — <%= content_for(:title) || "Dashboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-layout">
    <%# ── Body: sidebar + main ───────────────────────────────────────── %>
    <div class="d-flex admin-body">

      <%# Sidebar %>
      <nav class="admin-sidebar">
        <%= link_to admin_dashboard_path, class: "navbar-brand navbar-admin-brand d-flex align-items-center gap-2 mb-3 px-2" do %>
          <span>TapIn <span class="admin-badge">Admin</span></span>
        <% end %>

        <ul class="nav flex-column">
          <li class="nav-item">
            <%= link_to "Dashboard",         admin_dashboard_path,              class: "nav-link admin-nav-link #{active_link_class(admin_dashboard_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Members",           admin_members_path,                class: "nav-link admin-nav-link #{active_link_class(admin_members_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Rewards & Deals",   admin_rewards_path,                class: "nav-link admin-nav-link #{active_link_class(admin_rewards_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Mindbody",          admin_mindbody_matches_path,       class: "nav-link admin-nav-link #{active_link_class(admin_mindbody_matches_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Analytics",         admin_analytics_path,              class: "nav-link admin-nav-link #{active_link_class(admin_analytics_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Broadcasts",        admin_broadcasts_path,             class: "nav-link admin-nav-link #{active_link_class(admin_broadcasts_path)}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Notifications",     admin_notification_templates_path, class: "nav-link admin-nav-link #{active_link_class(admin_notification_templates_path)}" %>
          </li>
        </ul>

        <div class="mt-auto pt-3">
          <div class="mx-2 mb-3 border-top"></div>

          <div class="nav flex-column gap-1">
            <%= link_to admin_checkin_settings_path, class: "nav-link admin-nav-link" do %>
              <span>Check-in Setup</span>
            <% end %>

            <%= link_to admin_assistant_path, class: "nav-link admin-nav-link" do %>
              <span>Studio Assistant</span>
            <% end %>
          </div>

          <% if current_user.present? %>
            <% admin_display_name = [current_user.first_name, current_user.last_name].compact.join(" ").presence || "My Account" %>
            <% admin_contact = current_user.phone_user? ? current_user.phone : current_user.email %>

            <div class="position-relative mt-3" data-admin-account>
              <div class="d-none position-absolute end-0 bottom-100 mb-2 border rounded-3 shadow-sm overflow-hidden"
                   data-admin-account-menu
                   style="min-width: 190px; background: #FDFDF8;">
                <%= button_to destroy_user_session_path,
                              method: :delete,
                              class: "dropdown-item px-3 py-2" do %>
                  <i class="fa fa-sign-out me-2"></i>Logout
                <% end %>
              </div>

              <div class="d-flex align-items-center justify-content-between gap-2 px-2 py-2">
                <div class="d-flex align-items-center min-w-0 flex-grow-1">
                  <div class="min-w-0">
                    <div class="fw-semibold text-truncate"><%= admin_display_name %></div>
                    <div class="text-muted small text-truncate"><%= admin_contact %></div>
                  </div>
                </div>

                <button class="btn btn-sm border-0 px-1 text-muted bg-transparent shadow-none"
                        type="button"
                        data-admin-account-toggle
                        aria-expanded="false"
                        aria-label="Toggle account menu">
                  <i class="fa fa-chevron-down" data-chevron-closed></i>
                  <i class="fa fa-chevron-up d-none" data-chevron-open></i>
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </nav>

      <%# Main content %>
      <main class="flex-grow-1 p-4 admin-main">
        <% if notice.present? %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>

        <%= yield %>
      </main>

    </div>

    <script>
      function initAdminAccountMenus() {
        document.querySelectorAll("[data-admin-account]").forEach(function (account) {
          if (account.dataset.bound === "true") return;
          account.dataset.bound = "true";

          var toggle = account.querySelector("[data-admin-account-toggle]");
          var menu = account.querySelector("[data-admin-account-menu]");
          if (!toggle || !menu) return;
          var closedIcon = toggle.querySelector("[data-chevron-closed]");
          var openIcon = toggle.querySelector("[data-chevron-open]");

          function syncChevron() {
            var expanded = toggle.getAttribute("aria-expanded") === "true";
            if (closedIcon) closedIcon.classList.toggle("d-none", expanded);
            if (openIcon) openIcon.classList.toggle("d-none", !expanded);
          }

          function closeMenu() {
            toggle.setAttribute("aria-expanded", "false");
            menu.classList.add("d-none");
            syncChevron();
          }

          function openMenu() {
            toggle.setAttribute("aria-expanded", "true");
            menu.classList.remove("d-none");
            syncChevron();
          }

          toggle.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();

            if (toggle.getAttribute("aria-expanded") === "true") {
              closeMenu();
            } else {
              document.querySelectorAll("[data-admin-account-menu]").forEach(function (otherMenu) {
                otherMenu.classList.add("d-none");
              });
              document.querySelectorAll("[data-admin-account-toggle]").forEach(function (otherToggle) {
                otherToggle.setAttribute("aria-expanded", "false");
                var otherClosed = otherToggle.querySelector("[data-chevron-closed]");
                var otherOpen = otherToggle.querySelector("[data-chevron-open]");
                if (otherClosed) otherClosed.classList.remove("d-none");
                if (otherOpen) otherOpen.classList.add("d-none");
              });
              openMenu();
            }
          });

          document.addEventListener("click", function (event) {
            if (!account.contains(event.target)) {
              closeMenu();
            }
          });

          syncChevron();
        });
      }

      document.addEventListener("DOMContentLoaded", initAdminAccountMenus);
      document.addEventListener("turbo:load", initAdminAccountMenus);
    </script>
  </body>
</html>
