<% content_for :title, "#{@studio_class.name} — #{@studio.name}" %>

<div class="class-detail-page">

  <%# ── Hero ── %>
  <div class="detail-hero">
    <%= link_to classes_path(studio_slug: @studio.slug), class: "detail-back-link" do %>
      <i class="fa fa-arrow-left"></i> Back
    <% end %>

    <% if @studio_class.class_type.present? %>
      <div class="detail-hero-badge-wrap">
        <span class="class-type-badge"><%= @studio_class.class_type.upcase %></span>
      </div>
    <% end %>

    <h3 class="detail-class-name"><%= @studio_class.name %></h3>
    <p class="detail-studio-name"><%= @studio.name %></p>
  </div>

  <%# ── Info rows ── %>
  <div class="detail-body">

    <% if @studio_class.teacher_name.present? %>
      <div class="detail-info-row">
        <div class="detail-info-icon"><i class="fa fa-user"></i></div>
        <div class="detail-info-content">
          <p class="detail-info-label">Instructor</p>
          <p class="detail-info-value"><%= @studio_class.teacher_name %></p>
        </div>
      </div>
    <% end %>

    <div class="detail-info-row">
      <div class="detail-info-icon"><i class="fa fa-calendar"></i></div>
      <div class="detail-info-content">
        <p class="detail-info-label">Date</p>
        <p class="detail-info-value"><%= @studio_class.scheduled_at.strftime("%A, %B %-d, %Y") %></p>
      </div>
    </div>

    <div class="detail-info-row">
      <div class="detail-info-icon"><i class="fa fa-clock-o"></i></div>
      <div class="detail-info-content">
        <p class="detail-info-label">Time</p>
        <p class="detail-info-value">
          <%= @studio_class.scheduled_at.strftime("%-I:%M %p") %> &middot; <%= @studio_class.duration_minutes %> min
        </p>
      </div>
    </div>

    <div class="detail-info-row">
      <div class="detail-info-icon"><i class="fa fa-users"></i></div>
      <div class="detail-info-content detail-info-content--full">
        <p class="detail-info-label">Availability</p>
        <% if @studio_class.full? %>
          <p class="detail-info-value spots-full">Class full</p>
        <% else %>
          <p class="detail-info-value <%= @studio_class.spots_available <= 5 ? 'spots-low' : '' %>">
            <%= @studio_class.spots_available %> of <%= @studio_class.capacity %> spots remaining
          </p>
          <div class="spots-bar">
            <div class="spots-bar-fill"
                 style="width: <%= (@studio_class.spots_taken.to_f / @studio_class.capacity * 100).round %>%"></div>
          </div>
        <% end %>
      </div>
    </div>

    <% if @studio_class.class_config&.point_value.present? %>
      <div class="detail-info-row">
        <div class="detail-info-icon"><i class="fa fa-star"></i></div>
        <div class="detail-info-content">
          <p class="detail-info-label">Points Earned</p>
          <p class="detail-info-value">+<%= @studio_class.class_config.point_value %> pts after attending</p>
        </div>
      </div>
    <% end %>

    <%# ── About ── %>
    <% if @studio_class.description.present? %>
      <div class="detail-description">
        <h5 class="detail-desc-title">About This Class</h5>
        <p class="detail-desc-body"><%= @studio_class.description %></p>
      </div>
    <% end %>

  </div>

  <%# ── Fixed CTA bar ── %>
  <div class="detail-cta-bar">
    <% if @already_booked %>
      <div class="already-booked-badge">
        <i class="fa fa-check-circle"></i> You're booked for this class
      </div>
      <%= link_to "View My Bookings",
            bookings_path(studio_slug: @studio.slug),
            class: "btn-book btn-book--secondary" %>
    <% elsif @studio_class.full? %>
      <button class="btn-book btn-book--disabled" disabled>Class Full</button>
    <% elsif @studio_class.scheduled_at < Time.current %>
      <button class="btn-book btn-book--disabled" disabled>Class Ended</button>
    <% else %>
      <%= button_to "Book This Class",
            book_class_path(studio_slug: @studio.slug, id: @studio_class.id),
            method: :post,
            class: "btn-book" %>
    <% end %>
  </div>

</div>
