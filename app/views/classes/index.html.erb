<% content_for :title, "Class Schedule — #{@studio.name}" %>

<div class="schedule-page">

  <%# ── Hero ── %>
  <div class="schedule-hero">
    <div class="schedule-hero-inner">
      <div>
        <p class="schedule-studio-label"><%= @studio.name %></p>
        <h3 class="schedule-title">Class Schedule</h3>
      </div>
      <button class="schedule-filter-btn"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#scheduleFilters"
              aria-expanded="<%= (params[:day].present? || params[:class_type].present?) ? 'true' : 'false' %>"
              aria-controls="scheduleFilters">
        <i class="fa fa-sliders"></i>
      </button>
    </div>
  </div>

  <%# ── Collapsible filters ── %>
  <div class="collapse <%= 'show' if params[:day].present? || params[:class_type].present? %>"
       id="scheduleFilters">
    <div class="schedule-filter-panel">

      <%# Day filter %>
      <div class="filter-section">
        <p class="filter-section-label">Day</p>
        <div class="filter-scroll">
          <%= link_to classes_path(studio_slug: @studio.slug, class_type: params[:class_type]),
                class: "filter-day-btn #{params[:day].blank? ? 'filter-day-btn--active' : ''}" do %>
            <span class="filter-day-name">All</span>
          <% end %>
          <% 7.times do |i| %>
            <% day = Date.today + i %>
            <%= link_to classes_path(studio_slug: @studio.slug, day: day.iso8601, class_type: params[:class_type]),
                  class: "filter-day-btn #{params[:day] == day.iso8601 ? 'filter-day-btn--active' : ''}" do %>
              <span class="filter-day-name"><%= i == 0 ? "Today" : i == 1 ? "Tomorrow" : day.strftime("%A") %></span>
              <span class="filter-day-sub"><%= day.strftime("%a %-d") %></span>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# Class type filter %>
      <% if @class_types.any? %>
        <div class="filter-section">
          <p class="filter-section-label">Class Type</p>
          <div class="filter-scroll">
            <%= link_to "All",
                  classes_path(studio_slug: @studio.slug, day: params[:day]),
                  class: "filter-type-btn #{params[:class_type].blank? ? 'filter-type-btn--active' : ''}" %>
            <% @class_types.each do |type| %>
              <%= link_to type.capitalize,
                    classes_path(studio_slug: @studio.slug, day: params[:day], class_type: type),
                    class: "filter-type-btn #{params[:class_type] == type ? 'filter-type-btn--active' : ''}" %>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%# ── Class list ── %>
  <div class="schedule-list">
    <% if @classes.any? %>
      <% @classes.group_by { |c| c.scheduled_at.to_date }.each do |day, day_classes| %>

        <p class="schedule-day-label">
          <% if day == Date.today %>
            Today &middot; <%= day.strftime("%A, %B %-d") %>
          <% elsif day == Date.today + 1 %>
            Tomorrow &middot; <%= day.strftime("%A, %B %-d") %>
          <% else %>
            <%= day.strftime("%A, %B %-d") %>
          <% end %>
        </p>

        <div class="class-card-list">
          <% day_classes.each do |studio_class| %>
            <div class="sched-card <%= 'sched-card--full' if studio_class.full? %>">
              <div class="sched-card-header">
                <div class="sched-card-info">
                  <div class="sched-card-title-row">
                    <h4 class="sched-card-name"><%= studio_class.name %></h4>
                    <% if studio_class.class_config&.is_premium %>
                      <span class="premium-badge">Premium</span>
                    <% end %>
                  </div>
                  <div class="sched-card-meta">
                    <span><%= studio_class.scheduled_at.strftime("%-I:%M %p") %></span>
                    <span><%= studio_class.duration_minutes %> min</span>
                    <% if studio_class.teacher_name.present? %>
                      <span><%= studio_class.teacher_name %></span>
                    <% end %>
                  </div>
                </div>
                <div class="sched-card-spots">
                  <% if studio_class.full? %>
                    <span class="spots-full">Full</span>
                  <% elsif studio_class.spots_available <= 5 %>
                    <span class="spots-low"><%= studio_class.spots_available %> spots left</span>
                  <% else %>
                    <span class="spots-ok"><%= studio_class.spots_available %> spots</span>
                  <% end %>
                </div>
              </div>
              <% if @booked_class_ids.include?(studio_class.id) %>
                <span class="btn-book-card btn-book-card--booked">Booked</span>
              <% else %>
                <%= link_to "Book Class",
                      class_path(studio_slug: @studio.slug, id: studio_class.id),
                      class: "btn-book-card #{'btn-book-card--disabled' if studio_class.full?}" %>
              <% end %>
            </div>
          <% end %>
        </div>

      <% end %>
    <% else %>
      <div class="schedule-empty">
        <i class="fa fa-calendar-o"></i>
        <p>No classes found</p>
        <% if params[:day].present? || params[:class_type].present? %>
          <%= link_to "Clear filters", classes_path(studio_slug: @studio.slug), class: "clear-filters-link" %>
        <% end %>
      </div>
    <% end %>
  </div>

</div>
