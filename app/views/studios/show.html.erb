<% content_for(:title) { @studio.name } %>

<div class="container py-5" data-controller="nfc" data-nfc-studio-slug-value="<%= @studio.slug %>">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <% if @brand&.logo_url.present? %>
              <img src="<%= @brand.logo_url %>" alt="<%= @studio.name %> logo" class="img-fluid mb-3">
            <% end %>
            <h1 class="h3 mb-2"><%= @studio.name %></h1>
            <% if @brand&.tagline.present? %>
              <p class="text-muted mb-2"><%= @brand.tagline %></p>
            <% end %>
            <p class="mb-0">Herzlichen Glueckwunsch! 1 von 10 Punkten wartet auf dich.</p>
          </div>

          <%= form_with url: studio_phone_login_path(studio_slug: @studio.slug), method: :post, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :phone_number, "Telefonnummer", class: "form-label" %>
              <%= form.telephone_field :phone_number, class: "form-control", autocomplete: "tel", inputmode: "tel", placeholder: "+49 171 2345678", required: true %>
            </div>

            <%= form.submit "Code per SMS erhalten", class: "btn btn-dark w-100" %>
          <% end %>

          <p class="text-muted small mb-0 mt-3 text-center">
            Beim naechsten Tap geht es direkt weiter, solange du eingeloggt bleibst.
          </p>
        </div>
      </div>
    </div>
  </div>
  <div class="d-none" data-nfc-target="status"></div>
</div>
