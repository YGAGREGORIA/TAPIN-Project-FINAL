<% content_for :title, "Rewards — #{@studio.name}" %>

<% total_visits = current_user.visits_count_for(@studio) %>
<% nearest_threshold = @rewards.any? ? @rewards.map { |r| r.visits_required || 10 }.min : 10 %>

<div class="schedule-page">

  <%# ── Header ── %>
  <div class="schedule-header">
    <p class="schedule-studio-name"><%= @studio.name %></p>
    <h1 class="schedule-title">Rewards</h1>
    <p class="schedule-subtitle">
      <%= total_visits %> <%= total_visits == 1 ? "visit" : "visits" %> so far
    </p>
  </div>

  <%# ── Available Rewards ── %>
  <section class="dashboard-section">
    <p class="section-title">Available Rewards</p>
    <% if @rewards.any? %>
      <% @rewards.each do |reward| %>
        <% threshold = reward.visits_required || 10 %>
        <% progress = total_visits % threshold %>
        <% remaining = threshold - progress %>
        <% remaining = threshold if progress.zero? && !reward.redeemable_by?(current_user) %>
        <div class="reward-card">
          <div class="reward-name"><%= reward.name %></div>
          <% if reward.description.present? %>
            <p class="reward-description"><%= reward.description %></p>
          <% end %>

          <% if reward.redeemable_by?(current_user) %>
            <div class="stamp-card" style="margin: 12px 0 8px;">
              <div class="stamp-grid">
                <% threshold.times do |i| %>
                  <div class="stamp stamp--done">
                    <i class="fa fa-check"></i>
                  </div>
                <% end %>
              </div>
              <div class="stamp-card-footer">
                <div class="progress dashboard-progress">
                  <div class="progress-bar" style="width: 100%"></div>
                </div>
                <span class="stamp-count"><%= threshold %> / <%= threshold %></span>
              </div>
            </div>
            <span class="reward-ready-badge">Reward ready!</span>
            <%= button_to "Redeem Now",
                  redeem_reward_path(studio_slug: @studio.slug, id: reward.id),
                  method: :post,
                  class: "btn-redeem" %>
          <% else %>
            <div class="stamp-card" style="margin: 12px 0 8px;">
              <div class="stamp-grid">
                <% threshold.times do |i| %>
                  <div class="stamp <%= i < progress ? 'stamp--done' : '' %>">
                    <% if i < progress %>
                      <i class="fa fa-check"></i>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <div class="stamp-card-footer">
                <div class="progress dashboard-progress">
                  <div class="progress-bar" style="width: <%= (progress.to_f / threshold * 100).round %>%"></div>
                </div>
                <span class="stamp-count"><%= progress %> / <%= threshold %></span>
              </div>
            </div>
            <div class="visits-remaining-text">
              Unlocks after <%= threshold %> <%= threshold == 1 ? "visit" : "visits" %> &middot;
              <%= remaining %> remaining
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="dashboard-card">
        <div class="empty-state">
          <i class="fa fa-gift"></i>
          <p>No rewards available yet.</p>
        </div>
      </div>
    <% end %>
  </section>

  <%# ── History link ── %>
  <section class="dashboard-section pb-5">
    <div class="dashboard-card" style="text-align: center;">
      <%= link_to reward_redemptions_path(studio_slug: @studio.slug), class: "btn-secondary-action" do %>
        <i class="fa fa-history"></i> View Reward History
      <% end %>
    </div>
  </section>

</div>
