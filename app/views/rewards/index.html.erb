<% content_for :title, "Rewards — #{@studio.name}" %>

<% total_visits = current_user.visits_count_for(@studio) %>

<div class="dashboard">

  <%# ── Hero ── %>
  <div class="dashboard-hero">
    <div class="hero-inner">
      <div>
        <h3 class="hero-greeting">Rewards</h3>
        <p class="hero-points">
          <span class="hero-points-value"><%= total_visits %> <%= total_visits == 1 ? "visit" : "visits" %></span>
          at <%= @studio.name %>
        </p>
      </div>
      <%= link_to edit_user_registration_path, class: "hero-avatar-btn" do %>
        <i class="fa fa-user"></i>
      <% end %>
    </div>
  </div>

  <%# ── Scrollable content ── %>
  <div class="dashboard-content">

    <%# ── Per-reward progress cards ── %>
    <% if @rewards.any? %>
      <section class="dashboard-section animate-fade-up">
        <p class="section-title">Your Progress</p>
        <% @rewards.each do |reward| %>
          <% threshold = reward.visits_required || 10 %>
          <% progress  = total_visits % threshold %>
          <% redeemable = reward.redeemable_by?(current_user) %>
          <div class="studio-progress-card">
            <div class="progress-card-header">
              <h5 class="studio-name"><%= reward.name %></h5>
              <% if redeemable %>
                <span class="reward-ready-badge anim-glow-pulse">Reward ready!</span>
              <% end %>
            </div>

            <% if reward.description.present? %>
              <p style="font-size: 0.8125rem; color: var(--muted-foreground); margin: 0 0 1rem;">
                <%= reward.description %>
              </p>
            <% end %>

            <%# Stamp grid: rows of 5 %>
            <div class="stamp-rows">
              <% threshold.times.each_slice(5) do |row| %>
                <div class="stamp-row">
                  <% row.each do |i| %>
                    <% done = redeemable || i < progress %>
                    <div class="stamp-circle <%= done ? 'stamp-circle--done' : '' %>">
                      <i class="fa <%= done ? 'fa-star' : 'fa-star-o' %>"></i>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>

            <p class="stamp-count-text">
              <% if redeemable %>
                <%= threshold %> / <%= threshold %> visits
              <% else %>
                <%= progress %> / <%= threshold %> visits
              <% end %>
            </p>

            <% if redeemable %>
              <div style="text-align: center; margin-top: 0.75rem;">
                <%= button_to "Redeem Now",
                      redeem_reward_path(studio_slug: @studio.slug, id: reward.id),
                      method: :post,
                      class: "btn-redeem" %>
              </div>
            <% else %>
              <% remaining = threshold - progress %>
              <% remaining = threshold if progress.zero? %>
              <p class="visits-remaining-text">
                <%= remaining %> more <%= remaining == 1 ? "visit" : "visits" %> to unlock
              </p>
            <% end %>
          </div>
        <% end %>
      </section>

    <% else %>
      <section class="dashboard-section animate-fade-up">
        <p class="section-title">Available Rewards</p>
        <div class="dashboard-card">
          <div class="empty-state">
            <i class="fa fa-gift"></i>
            <p>No rewards available yet.</p>
          </div>
        </div>
      </section>
    <% end %>

    <%# ── History link ── %>
    <section class="dashboard-section dashboard-section--last animate-fade-up">
      <p class="section-title">Reward History</p>
      <div class="dashboard-card">
        <div class="reward-row">
          <div class="reward-row-icon">
            <i class="fa fa-history"></i>
          </div>
          <div class="reward-row-details">
            <p class="reward-row-name">View Past Redemptions</p>
            <p class="reward-row-meta">See codes and expiry dates</p>
          </div>
          <%= link_to reward_redemptions_path(studio_slug: @studio.slug), class: "btn-redeem" do %>
            View <i class="fa fa-chevron-right" style="font-size: 0.75rem; margin-left: 0.25rem;"></i>
          <% end %>
        </div>
      </div>
    </section>

  </div><%# end .dashboard-content %>

</div>
