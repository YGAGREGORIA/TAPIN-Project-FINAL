<% content_for :title, "Profile" %>

<div class="profile-page">

  <%# ── Header ── %>
  <div class="profile-hero">
    <h3 class="profile-hero-title">Profile</h3>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "profile-form", multipart: true }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="profile-body">

      <%# ── Avatar ── %>
      <div class="profile-avatar-section">
        <div class="profile-avatar-wrap">
          <div class="profile-avatar">
            <% if current_user.avatar.attached? %>
              <%= image_tag current_user.avatar, class: "profile-avatar-img", alt: "Profile photo" %>
            <% elsif current_user.first_name.present? || current_user.last_name.present? %>
              <span class="profile-avatar-initials">
                <%= current_user.first_name&.first&.upcase %><%= current_user.last_name&.first&.upcase %>
              </span>
            <% else %>
              <span class="profile-avatar-initials"><%= current_user.email.first.upcase %></span>
            <% end %>
          </div>
          <label class="profile-avatar-camera" aria-label="Upload photo">
            <i class="fa fa-camera"></i>
            <%= f.file_field :avatar, accept: "image/*", class: "profile-avatar-input" %>
          </label>
        </div>
        <p class="profile-avatar-hint">Tap camera to upload photo</p>
      </div>

      <%# ── Personal Information ── %>
      <div class="profile-section">
        <h4 class="profile-section-title">Personal Information</h4>

        <div class="profile-fields">
          <div class="profile-field">
            <%= f.label :first_name, "First Name", class: "profile-label" %>
            <%= f.text_field :first_name, class: "profile-input", placeholder: "First name", autocomplete: "given-name" %>
          </div>

          <div class="profile-field">
            <%= f.label :last_name, "Last Name", class: "profile-label" %>
            <%= f.text_field :last_name, class: "profile-input", placeholder: "Last name", autocomplete: "family-name" %>
          </div>

          <div class="profile-field">
            <%= f.label :phone, "Phone Number", class: "profile-label" %>
            <%= f.telephone_field :phone, class: "profile-input", placeholder: "+1 (555) 000-0000", autocomplete: "tel" %>
          </div>

          <div class="profile-field">
            <label class="profile-label">Email Address</label>
            <p class="profile-input" style="background:#f8f9fa;color:#6c757d;cursor:default;"><%= resource.email %></p>
          </div>

          <%# ── Change password section (only required when changing email/password) ── %>
          <div class="profile-field" id="change-password-toggle">
            <button type="button" class="btn btn-link p-0 profile-label" id="show-password-fields">
              Change password or email?
            </button>
          </div>

          <div id="password-fields" style="display:none;">
            <div class="profile-field">
              <%= f.label :email, "New Email Address", class: "profile-label" %>
              <%= f.email_field :email, class: "profile-input", autocomplete: "email",
                    value: resource.unconfirmed_email.presence || resource.email %>
              <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                <p class="profile-field-hint">Pending confirmation for: <%= resource.unconfirmed_email %></p>
              <% end %>
            </div>

            <div class="profile-field">
              <%= f.label :password, "New Password", class: "profile-label" %>
              <div class="profile-input-wrap">
                <%= f.password_field :password, class: "profile-input profile-input--padded-r",
                      autocomplete: "new-password",
                      placeholder: "Leave blank to keep current" %>
                <button type="button" class="profile-pw-toggle" aria-label="Toggle password">
                  <i class="fa fa-eye-slash"></i>
                </button>
              </div>
              <p class="profile-field-hint">Must be at least <%= @minimum_password_length || 8 %> characters with uppercase, lowercase, and a number</p>
            </div>

            <div class="profile-field">
              <%= f.label :password_confirmation, "Confirm New Password", class: "profile-label" %>
              <%= f.password_field :password_confirmation, class: "profile-input",
                    autocomplete: "new-password", placeholder: "Repeat new password" %>
            </div>

            <div class="profile-field">
              <%= f.label :current_password, "Current Password", class: "profile-label" %>
              <%= f.password_field :current_password, class: "profile-input",
                    autocomplete: "current-password", placeholder: "Required to confirm changes" %>
            </div>
          </div>
        </div>
      </div>

      <%# ── Social Media ── %>
      <div class="profile-section">
        <h4 class="profile-section-title">Social Media</h4>

        <div class="profile-fields">
          <div class="profile-field">
            <label class="profile-label profile-label--social profile-label--instagram">
              <i class="fa-brands fa-instagram"></i> Instagram
            </label>
            <%= f.text_field :instagram, class: "profile-input", placeholder: "@username" %>
          </div>

          <div class="profile-field">
            <label class="profile-label profile-label--social profile-label--facebook">
              <i class="fa-brands fa-facebook-f"></i> Facebook
            </label>
            <%= f.text_field :facebook, class: "profile-input", placeholder: "username or profile URL" %>
          </div>

          <div class="profile-field">
            <label class="profile-label profile-label--social profile-label--linkedin">
              <i class="fa-brands fa-linkedin-in"></i> LinkedIn
            </label>
            <%= f.text_field :linkedin, class: "profile-input", placeholder: "username or profile URL" %>
          </div>
        </div>
      </div>

      <%# ── Save ── %>
      <div class="profile-save">
        <%= f.submit "Save Changes", class: "btn-book" %>
      </div>

      <%# ── Danger zone ── %>
      <div class="profile-danger">
        <h5 class="profile-danger-title">Danger Zone</h5>
        <%= button_to "Delete Account",
              registration_path(resource_name),
              data: { turbo_confirm: "Are you sure? This cannot be undone." },
              method: :delete,
              class: "profile-danger-btn" %>
      </div>

    </div>
  <% end %>

</div>

<script>
  document.querySelectorAll('.profile-pw-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = btn.closest('.profile-input-wrap').querySelector('input');
      const icon  = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      } else {
        input.type = 'password';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      }
    });
  });

  const toggleBtn = document.getElementById('show-password-fields');
  const passwordFields = document.getElementById('password-fields');
  if (toggleBtn && passwordFields) {
    toggleBtn.addEventListener('click', () => {
      passwordFields.style.display = passwordFields.style.display === 'none' ? 'block' : 'none';
      toggleBtn.textContent = passwordFields.style.display === 'none' ? 'Change password or email?' : 'Hide';
    });
  }

  <% if resource.errors.any? && (resource.errors[:password].any? || resource.errors[:email].any? || resource.errors[:current_password].any?) %>
    if (passwordFields) passwordFields.style.display = 'block';
    if (toggleBtn) toggleBtn.textContent = 'Hide';
  <% end %>
</script>
