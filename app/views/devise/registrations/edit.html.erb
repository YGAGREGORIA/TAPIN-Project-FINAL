<% content_for :title, "Profile" %>

<div class="profile-page">

  <%# ── Header ── %>
  <div class="profile-hero">
    <h3 class="profile-hero-title">Profile</h3>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "profile-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="profile-body">

      <%# ── Avatar ── %>
      <div class="profile-avatar-section">
        <div class="profile-avatar">
          <span class="profile-avatar-initials">
            <%= current_user.first_name&.first&.upcase %><%= current_user.last_name&.first&.upcase %>
          </span>
          <span class="profile-avatar-fallback"><%= current_user.email.first.upcase %></span>
        </div>
        <p class="profile-avatar-hint">Tap to upload photo</p>
      </div>

      <%# ── Personal Information ── %>
      <div class="profile-section">
        <h4 class="profile-section-title">Personal Information</h4>

        <div class="profile-fields">
          <div class="profile-field">
            <%= f.label :first_name, "First Name", class: "profile-label" %>
            <%= f.text_field :first_name, class: "profile-input", placeholder: "First name", autocomplete: "given-name" %>
          </div>

          <div class="profile-field">
            <%= f.label :last_name, "Last Name", class: "profile-label" %>
            <%= f.text_field :last_name, class: "profile-input", placeholder: "Last name", autocomplete: "family-name" %>
          </div>

          <div class="profile-field">
            <%= f.label :phone, "Phone Number", class: "profile-label" %>
            <%= f.telephone_field :phone, class: "profile-input", placeholder: "+1 (555) 000-0000", autocomplete: "tel" %>
          </div>

          <div class="profile-field">
            <%= f.label :email, "Email Address", class: "profile-label" %>
            <%= f.email_field :email, class: "profile-input", autocomplete: "email" %>
            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <p class="profile-field-hint">Pending confirmation for: <%= resource.unconfirmed_email %></p>
            <% end %>
          </div>

          <div class="profile-field">
            <%= f.label :password, "New Password", class: "profile-label" %>
            <div class="profile-input-wrap">
              <%= f.password_field :password, class: "profile-input profile-input--padded-r",
                    autocomplete: "new-password",
                    placeholder: "Leave blank to keep current" %>
              <button type="button" class="profile-pw-toggle" aria-label="Toggle password">
                <i class="fa fa-eye-slash"></i>
              </button>
            </div>
            <p class="profile-field-hint">Must be at least <%= @minimum_password_length || 8 %> characters</p>
          </div>

          <div class="profile-field">
            <%= f.label :password_confirmation, "Confirm New Password", class: "profile-label" %>
            <%= f.password_field :password_confirmation, class: "profile-input",
                  autocomplete: "new-password", placeholder: "Repeat new password" %>
          </div>

          <div class="profile-field">
            <%= f.label :current_password, "Current Password", class: "profile-label" %>
            <%= f.password_field :current_password, class: "profile-input",
                  autocomplete: "current-password", placeholder: "Required to save changes" %>
          </div>
        </div>
      </div>

      <%# ── Save ── %>
      <div class="profile-save">
        <%= f.submit "Save Changes", class: "btn-book" %>
      </div>

      <%# ── Danger zone ── %>
      <div class="profile-danger">
        <h5 class="profile-danger-title">Danger Zone</h5>
        <%= button_to "Delete Account",
              registration_path(resource_name),
              data: { turbo_confirm: "Are you sure? This cannot be undone." },
              method: :delete,
              class: "profile-danger-btn" %>
      </div>

    </div>
  <% end %>

</div>

<script>
  document.querySelectorAll('.profile-pw-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = btn.closest('.profile-input-wrap').querySelector('input');
      const icon  = btn.querySelector('i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
      } else {
        input.type = 'password';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
      }
    });
  });
</script>
