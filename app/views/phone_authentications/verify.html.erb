<% content_for(:title) { "#{@studio.name} Check-in bestaetigen" } %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <% if @brand&.logo_url.present? %>
              <img src="<%= @brand.logo_url %>" alt="<%= @studio.name %> logo" class="img-fluid mb-3">
            <% end %>
            <h1 class="h3 mb-2"><%= @studio.name %></h1>
            <p class="text-muted mb-0">Gib den SMS-Code ein, um deinen Punkt zu speichern.</p>
          </div>

          <%= form_with url: confirm_studio_phone_login_path(studio_slug: @studio.slug), method: :post, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :verification_code, "Bestaetigungscode", class: "form-label" %>
              <%= form.text_field :verification_code, class: "form-control", autocomplete: "one-time-code", inputmode: "numeric", maxlength: 6, required: true %>
            </div>

            <%= form.submit "Punkt speichern", class: "btn btn-dark w-100" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
