<% content_for :title, "TapIn – Choose Your Studio" %>

<div class="studio-picker">
  <div class="studio-picker__inner">

    <div class="studio-picker__header">
      <h1 class="studio-picker__logo">TAPIN<span>.</span></h1>
      <p class="studio-picker__tagline">Choose your studio to tap in</p>
    </div>

    <div class="studio-picker__grid">
      <% @studios.each do |studio| %>
        <% brand = studio.studio_brand %>
        <%= link_to studio_landing_path(studio_slug: studio.slug), class: "studio-card" do %>
          <div class="studio-card__color-bar" style="background: <%= brand&.primary_color || '#87A878' %>;"></div>
          <div class="studio-card__body">
            <h2 class="studio-card__name"><%= studio.name %></h2>
            <% if brand&.tagline.present? %>
              <p class="studio-card__tagline"><%= brand.tagline %></p>
            <% end %>
            <div class="studio-card__meta">
              <span class="studio-card__rewards"><i class="fa fa-gift"></i> <%= studio.rewards.active.count %> rewards</span>
              <span class="studio-card__deals"><i class="fa fa-tag"></i> <%= studio.deals.active.count %> deals</span>
            </div>
            <div class="studio-card__cta">
              Tap In <i class="fa fa-arrow-right"></i>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="studio-picker__footer">
      <p>Studio owner? <%= link_to "Admin login", new_user_session_path, class: "studio-picker__link" %></p>
    </div>

  </div>
</div>

<style>
  .studio-picker {
    min-height: 100vh;
    background: #FDFDF8;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .studio-picker__inner {
    width: 100%;
    max-width: 500px;
  }

  .studio-picker__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .studio-picker__logo {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 2.25rem;
    color: #87A878;
    letter-spacing: -1.5px;
    margin: 0 0 0.5rem;
  }

  .studio-picker__logo span {
    color: #E07A5F;
  }

  .studio-picker__tagline {
    color: rgba(0, 0, 0, 0.45);
    font-size: 1rem;
    margin: 0;
  }

  .studio-picker__grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .studio-card {
    display: block;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    color: #1a1a2e;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .studio-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.1);
    color: #1a1a2e;
    text-decoration: none;
  }

  .studio-card__color-bar {
    height: 6px;
  }

  .studio-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .studio-card__name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
  }

  .studio-card__tagline {
    color: rgba(0, 0, 0, 0.45);
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }

  .studio-card__meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: rgba(0, 0, 0, 0.4);
    margin-bottom: 1rem;
  }

  .studio-card__meta i {
    color: #E07A5F;
    margin-right: 0.25rem;
  }

  .studio-card__cta {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    color: #E07A5F;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .studio-card:hover .studio-card__cta {
    gap: 0.75rem;
  }

  .studio-picker__footer {
    text-align: center;
    margin-top: 2rem;
    font-size: 0.8rem;
    color: rgba(0, 0, 0, 0.35);
  }

  .studio-picker__link {
    color: #E07A5F;
    text-decoration: none;
    font-weight: 600;
  }

  .studio-picker__link:hover {
    text-decoration: underline;
  }
</style>
